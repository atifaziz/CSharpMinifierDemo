@page "/"
@implements IDisposable
@using System.Diagnostics
@using System.Linq;
@using System.Security.Cryptography
@using System.Text;
@using System.Threading;
@using CSharpMinifier
@inject IJSRuntime JSRuntime

<div id="stats">
    @if (_ms is TimeSpan ms)
    {
        <span title="Peformance">&#x231A; @ms.TotalSeconds.ToString("0.0000") secs</span>
        <span>Input: @_input.Length.ToString("N0") chars</span>
        <span>Output: @_output.Length.ToString("N0") chars (@(Math.Round(_output.Length * 100.0 / _input.Length, 0))%)</span>
        <span>Tokens: @_tokenCount.ToString("N0")</span>
        <span>SHA1: <span id="hash">@_hash</span></span>
    }
    else
    {
        <a class="@(_dirty ? "hidden" : null)"
           target="about-csmin"
           href="https://github.com/atifaziz/CSharpMinifier">&#x1F6C8; What is this?</a>
    }
</div>

<textarea @bind=@_input
          @bind:event="oninput"
          @onkeyup=@(_ => DebouncedMinifyAsync())
          @ref="_inputTextArea"
          autofocus wrap="off"
          placeholder="Enter/Paste some C# valid code here to minify"></textarea>

<textarea readonly
          class="@(_error ? "syntax-error" : null)"
          @bind=@_output></textarea>

@functions
{
    static readonly TimeSpan BaseDebounce = TimeSpan.FromMilliseconds(150);
    static readonly TimeSpan MaxDebounce = TimeSpan.FromSeconds(2);
    const double DebounceMultiplier = 1.5;

    bool _dirty;
    string _input;
    string _lastInput;
    string _output;
    int _tokenCount;
    string _hash;
    bool _error;
    TimeSpan? _ms;
    ElementReference _inputTextArea;
    CancellationTokenSource _debounceCancellationTokenSource;
    TimeSpan _debounceDelay = BaseDebounce;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
            await JSRuntime.InvokeAsync<object>("$onpaste", _inputTextArea, DotNetObjectReference.Create(this));
    }

    [JSInvokable]
    public void OnPaste(string value)
    {
        _debounceCancellationTokenSource?.Cancel();
        _input = value;
        Minify(CancellationToken.None);
        StateHasChanged();
    }

    async Task DebouncedMinifyAsync()
    {
        _debounceCancellationTokenSource?.Cancel();
        _debounceCancellationTokenSource = new CancellationTokenSource();
        var cancellationToken = _debounceCancellationTokenSource.Token;

        try
        {
            await Task.Delay(_debounceDelay, cancellationToken);

            Minify(cancellationToken);

            // Update debounce delay based on last minification time

            if (_ms is { } ms)
            {
                // Adaptive delay: base + multiplier of last minification time, clamped to bounds
                var adaptiveDelay = BaseDebounce + ms * DebounceMultiplier;
                _debounceDelay = adaptiveDelay < BaseDebounce ? BaseDebounce
                               : adaptiveDelay > MaxDebounce ? MaxDebounce
                               : adaptiveDelay;
            }
            else
            {
                _debounceDelay = BaseDebounce;
            }
        }
        catch (OperationCanceledException)
        {
            // Debounce cancelled by new input - expected behavior
        }
    }

    void Minify(CancellationToken cancellationToken)
    {
        if (_lastInput == _input) {
            return;
        }

        _lastInput = _input;
        _error = false;
        _ms = null;

        if (_input.Length == 0) {
            _output = string.Empty;
            return;
        }

        _dirty = true;

        var sw = Stopwatch.StartNew();

        try
        {
            var sb = new StringBuilder();
            var i = 0;
            foreach (var tokenText in Minifier.Minify(_input))
            {
                if (i % 100 == 0) // check for cancellation every so tokens
                    cancellationToken.ThrowIfCancellationRequested();

                sb.Append(tokenText);
                i++;
            }
            _output = sb.ToString();
            _ms = sw.Elapsed;
        }
        catch (SyntaxErrorException e)
        {
            _output = e.Message;
            _error = true;
            return;
        }

        var tokenCount = _tokenCount = 0;
        foreach (var _ in Scanner.Scan(_input))
        {
            if (tokenCount % 100 == 0) // check for cancellation every so tokens
                cancellationToken.ThrowIfCancellationRequested();
            tokenCount++;
        }
        _tokenCount = tokenCount;

        var ha = SHA1.Create();
        var utf8 = new UTF8Encoding(encoderShouldEmitUTF8Identifier: false);
        _hash = BitConverter.ToString(ha.ComputeHash(utf8.GetBytes(_output)))
                            .Replace("-", string.Empty)
                            .ToLowerInvariant();
    }

    public void Dispose()
    {
        if (_debounceCancellationTokenSource is { } cancellationTokenSource)
        {
            cancellationTokenSource.Cancel();
            cancellationTokenSource.Dispose();
        }
    }
}
